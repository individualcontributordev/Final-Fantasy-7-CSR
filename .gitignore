# Local disc images — never commit game data or large binaries
#
# Layout:
#   pristine/     retail NTSC-U masters (store once)
#   cache/        optional reconstructed bases (csr, highwind, …) — not workflow owner
#   workspace/    LEGACY alias (still gitignored; scripts fall back if present)
#   temp/         layer-stack playtest outputs
# Session edits live in builder zip extracts (Downloads/), not under pristine/.

pristine/*
!pristine/**/
!pristine/**/.gitkeep

cache/*
!cache/**/
!cache/**/.gitkeep

# Legacy path (pre rename)
workspace/*
!workspace/**/
!workspace/**/.gitkeep

# Disc / dump files in local image dirs
pristine/**/*.bin
pristine/**/*.BIN
pristine/**/*.cue
pristine/**/*.CUE
cache/**/*.bin
cache/**/*.BIN
cache/**/*.cue
cache/**/*.CUE
workspace/**/*.bin
workspace/**/*.BIN
workspace/**/*.cue
workspace/**/*.CUE
**/FINALFANTASY7_D*.bin
**/FINALFANTASY7_D*.BIN

# Other dump / intermediate forms
**/*.{img,iso,ISO,ccd,sub,toc,mds,mdf,nrg,chd,ecm}
**/*.dec
**/*.dec.*
**/*.new
**/*.pristine
**/*.{gz,gzip}

# Extracted FIELD.BIN and intermediates
**/FIELD.BIN
**/FIELD.BIN.*

# Emulator / save junk if dropped in the repo
**/*.{mcd,sav,srm,state,dst}
**/duckstation*/
**/*.duckstation*

# Pages staging (CI only)
_site/

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.env

# OS / editor
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db
$RECYCLE.BIN/
*.lnk
*.swp
*~
.idea/
.vscode/
*.code-workspace
temp/
